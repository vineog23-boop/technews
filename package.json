{
  "name": "technews",
  "version": "1.0.0",
  "description": "TechNews: clone do TabNews feito por Vinicius como projeto de estudo do curso.dev (Node.js, Next.js, React e PostgreSQL).",
  "private": true,
  "scripts": {
    "dev": "npm run services:up && next dev",
    "build": "next build",
    "start": "next start",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:stop": "docker compose -f infra/compose.yaml stop"
  },
  "author": "Vinicius",
  "dependencies": {
    "next": "^16.3.5",
    "pg": "^8.11.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "jest": "^29.6.2",
    "prettier": "^3.9.8"
  }
}
